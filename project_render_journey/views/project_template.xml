<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template inherit_id="project.portal_my_project" id="project_portal_my_project_inherit" name="Project: Portal">
        <xpath expr="//t[@t-set='card_body']" position="inside">
            <div class="row">
                <div t-if="project.partner_id" class="col-12 col-md-6 mb-2 mb-md-0">
                    <h6>Address</h6>
                        <address t-field="project.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address"]}'/>

                </div>
                <div class="col-md-6">

                </div>
            </div>
        </xpath>
    </template>
</odoo>