    <template id="portal_project_journey" name="Project Journey">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-set="o_portal_fullwidth_alert" groups="project.group_project_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#model=project.project&amp;id=%s&amp;view_type=form' % (project.id)"/>
                </t>
            </t>
            <t t-call="portal.portal_record_layout" class="mt-3">
                <t t-set="card_header">
                    <h3 class="mb-0">
                        <span t-field="project.name" class="text-truncate"/>
                        <span class="float-right">
                            <a role="button" t-attf-href="/my/project/#{project.id}?{{ keep_query() }}"
                               class="btn btn-sm btn-secondary">
                                <span class="fa fa-puzzle-piece" role="img" aria-label="Project" title="Project"/>
                                See Project Details
                            </a>
                        </span>

                        <span class="float-right mr-2">
                            <a role="button" t-attf-href="/project/render/#{project.id}?{{ keep_query() }}"
                               class="btn btn-sm btn-secondary">
                                <span class="fa fa-image" role="img" aria-label="Project" title="Project"/>
                                See Project Renders
                            </a>
                        </span>
                    </h3>
                </t>
                <t t-set="card_body">
                    <div class="row col-md-12">
                        <div class="col-md-12" t-if="project_renders.mapped('project_journey_images')">
                            <h2 class="text-center">
                                <u>
                                    <strong>Pictures completion work</strong>
                                </u>
                            </h2>
                        </div>
                        <t t-foreach="project_renders.mapped('project_journey_images')" t-as="d_image">
                            <div class="col-md-3 text-center">
                                <h4>
                                    <t t-esc="d_image.name"/>
                                </h4>
                                <img t-att-src="image_data_uri(d_image.image_1920)" class="img-thumbnail image-container"/>
                            </div>
                        </t>
                    </div>
                    <div class="row col-md-12">
                        <div class="col-md-12" t-if="project_renders.mapped('project_journey_defect_list')">
                            <h2 class="text-center">
                                <u>
                                    <strong>Completion with follow up defects list</strong>
                                </u>
                            </h2>
                        </div>
                        <t t-foreach="project_renders.mapped('project_journey_defect_list')" t-as="d_image">
                            <div class="col-md-3 text-center">
                                <h4>
                                    <t t-esc="d_image.name"/>
                                </h4>
                                <img t-att-src="image_data_uri(d_image.image_1920)" class="img-thumbnail image-container"/>
                            </div>
                        </t>
                    </div>
                    <div class="row col-md-12">
                        <div class="col-md-12" t-if="project_renders.mapped('project_journey_defect_acknowledge')">
                            <h2 class="text-center">
                                <u>
                                    <strong>Acknowledge defects</strong>
                                </u>
                            </h2>
                        </div>
                        <t t-foreach="project_renders.mapped('project_journey_defect_acknowledge')" t-as="d_image">
                            <div class="col-md-3 text-center">
                                <h4>
                                    <t t-esc="d_image.name"/>
                                </h4>
                                <img t-att-src="image_data_uri(d_image.image_1920)" class="img-thumbnail image-container"/>
                            </div>
                        </t>
                    </div>
                    <div class="row col-md-12">
                        <div class="col-md-12" t-if="project_renders.mapped('project_journey_calendar_activity')">
                            <h2 class="text-center">
                                <u>
                                    <strong>Calendar Activities</strong>
                                </u>
                            </h2>
                        </div>
                        <t t-foreach="project_renders.mapped('project_journey_calendar_activity')" t-as="d_image">
                            <div class="col-md-3 text-center">
                                <h4>
                                    <t t-esc="d_image.name"/>
                                </h4>
                                <img t-att-src="image_data_uri(d_image.image_1920)" class="img-thumbnail image-container"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template inherit_id="project.portal_my_project" id="portal_project_inherit_id" name="Project Portal Inherit">
        <xpath expr="//t[@t-call='portal.portal_record_layout']/t[@t-set='card_header']/h5[hasclass('mb-0')]/span[hasclass('float-right')]"
               position="before">
            <span class="float-right">
                <a role="button" t-attf-href="/project/render/#{project.id}?{{ keep_query() }}"
                   class="btn btn-sm btn-secondary">
                    <span class="fa fa-image" role="img" aria-label="Renders" title="Renders"/>
                    Project Renders
                </a>
            </span>
            <span class="float-right ml-1 mr-1">
                <a role="button" t-attf-href="/project/journey/#{project.id}?{{ keep_query() }}"
                   class="btn btn-sm btn-secondary">
                    <span class="fa far fa-map" role="img" aria-label="Project" title="Project"/>
                    See Project Journey
                </a>
            </span>
        </xpath>
    </template>
</odoo>
