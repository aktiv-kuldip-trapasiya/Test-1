<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add website_short_description to website product item template -->
        <template id="website_sale_products_item_website_short_description" inherit_id="theme_prime.product_item_grid_1">
            <xpath expr="//h6" position="after">
                <div t-if="product.website_short_description" 
                     class="product_short_description mt-2 mb-2" 
                     style="font-size: 0.8em; color: #666; line-height: 1.5; max-height: 3em; overflow: hidden;">
                    <t t-esc="product.website_short_description" t-options='{"widget": "html"}'/>
                </div>
            </xpath>
        </template>

        <!-- Add website_short_description to Theme Prime product item grid 2 template -->
        <template id="theme_prime_product_item_grid_2_website_short_description" inherit_id="theme_prime.product_item_grid_2">
            <xpath expr="//h6" position="after">
                <div t-if="product.website_short_description" 
                     class="product_short_description mt-2 mb-2" 
                     style="font-size: 0.8em; color: #666; line-height: 1.5; max-height: 3em; overflow: hidden;">
                    <t t-esc="product.website_short_description" t-options='{"widget": "html"}'/>
                </div>
            </xpath>
        </template>



    </data>
</odoo>
