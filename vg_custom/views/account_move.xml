<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_custom" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="retention_perc"
                    attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"
                />
            </xpath>
            <!-- <xpath expr="//field[@name='amount_total']" position="before">
                <field name="warranty_retention" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
            </xpath> -->
        </field>
    </record>
</odoo>