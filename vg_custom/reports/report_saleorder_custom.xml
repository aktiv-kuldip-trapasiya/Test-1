<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']" position="replace">
            <div>
                <table style="border: 1px solid; width:25%; float:left; margin-bottom: 20px">
                    <tr>
                        <th style="border: 1px solid; padding-left: 5px"> PPT. NUM</th>
                        <th style="border: 1px solid; text-align: center;">
                            <span t-field="doc.name"></span>
                        </th>
                    </tr>
                    <tr>
                        <td style="border: 1px solid; padding-left: 5px"> FECHA</td>
                        <td style="border: 1px solid; text-align: center;">
                            <span t-esc="doc.date_order.strftime('%d/%m/%Y')"></span>
                        </td>
                    </tr>
                </table>
            </div>
            <div>
                <table style="width:35%; float: right">
                    <tr>
                        <td style="text-align: center; height: 90px;">
                            <img
                                src="/vg_custom/static/img/logo_signos.jpg"
                                alt="Logo"
                                style="max-height: 80px;  margin-top: 5px"
                            />
                        </td>
                    </tr>
                </table>
            </div>

            <div>
                <table style="border: 1px solid; width:60%; float: left; margin-bottom: 20px ">
                    <tr>
                        <th style="border: 1px solid; padding-left: 5px">CLIENTE</th>
                    </tr>
                    <tr>
                        <td style="border: 1px solid; padding-left: 5px">
                            <div t-field="doc.partner_id"
                                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" />
                            <p t-if="doc.partner_id.vat"><t
                                    t-esc="doc.company_id.country_id.vat_label or 'Tax ID'" />: <span
                                    t-field="doc.partner_id.vat" /></p>
                        </td>
                    </tr>
                </table>
            </div>
            <br></br>
            <br></br>
            <br></br>
            <div style="float:left; width:100%;">
                <table
                    style="border: 1px solid; width:100%; float:left; margin-bottom: 20px; background-color: #ACE1AF; height: 80px;">
                    <tr>
                        <th
                            style="border: 1px solid; width:15%;padding-left: 5px;text-align: left;padding-top: 20px;">
                            REF</th>
                        <th style="border: 1px solid; width:85%; text-align: center;">
                            <span t-field="doc.refernce_report"></span>
                        </th>
                    </tr>
                </table>
            </div>
        </xpath>
        <xpath expr="//t[@t-set='information_block']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//h2[@class='mt16']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//table[@class='table table-sm o_main_table']" position="replace">
            <table class="table table-sm o_main_table">
                <thead style="display: table-row-group">
                    <tr style="border: 1px solid;">
                        <th name="th_quantity" class="text-center"
                            style="border: 1px solid;width:10%">
                            Uom</th>
                        <th name="th_description" class="text-center"
                            style="border: 1px solid;width:60%">
                            Description</th>
                        <th name="th_uom" class="text-center" style="border: 1px solid;width:10%">
                            Quantity</th>
                        <th name="th_priceunit" class="text-center"
                            style="border: 1px solid;width:10%">
                            Price/Unit</th>
                        <th name="th_subtotal" class="text-center"
                            style="border: 1px solid;width:10%">
                            <span>Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <tr style="border: 1px solid;">
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>

                    </tr>
                    <t t-set="current_subtotal" t-value="0" />

                    <t t-foreach="doc.order_line" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                            groups="account.group_show_line_subtotals_tax_excluded" />
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                            groups="account.group_show_line_subtotals_tax_included" />

                        <tr
                            t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''"
                            style="border: 1px solid;">
                            <t t-if="not line.display_type">

                                <td name="td_uom" style="border: 1px solid;" class="text-center">
                                    <span t-field="line.product_uom_q" />
                                </td>
                                <td name="td_name" style="border: 1px solid;">
                                    <span t-field="line.name" />
                                </td>
                                <td name="td_quantity" style="border: 1px solid;"
                                    class="text-center">
                                    <span t-field="line.product_uom_qty" />
                                </td>
                                <td name="td_priceunit" style="border: 1px solid;"
                                    class="text-center">
                                    <span t-field="line.price_unit" />
                                </td>
                                <td name="td_subtotal" class="text-right o_price_total"
                                    style="border: 1px solid;">
                                    <span t-field="line.price_subtotal"
                                        groups="account.group_show_line_subtotals_tax_excluded" />
                                    <span t-field="line.price_total"
                                        groups="account.group_show_line_subtotals_tax_included" />
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td style="border: 1px solid;"></td>
                                <td name="td_section_line" style="border: 1px solid;">
                                    <span t-field="line.name" />
                                </td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subtotal" t-value="0" />
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td style="border: 1px solid;"></td>

                                <td name="td_section_line" style="border: 1px solid;">
                                    <span t-field="line.name" />
                                </td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>

                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subtotal" t-value="0" />
                            </t>
                        </tr>
                    </t>
                    <tr class="text-right" style="border: 1px solid;">
                        <td style="border: 1px solid;"></td>
                        <td name="td_subtotal" style="border: 1px solid;">
                            <strong class="mr16">Amount Untaxed</strong>
                        </td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;" class="text-right">
                            <span t-field="doc.amount_untaxed" />
                        </td>
                    </tr>
                    <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                        <tr class="text-right" style="border: 1px solid;background-color: #ACE1AF">
                            <t
                                t-if="amount_by_group[5] == 1 and doc.amount_untaxed == amount_by_group[2]">
                                <td style="border: 1px solid;"></td>
                                <td name="td_subtotal" style="border: 1px solid;">
                                    <strong class="mr16">
                                        <span t-esc="amount_by_group[0]"></span>
                                    </strong>
                                </td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;" class="text-right">
                                    <span t-esc="amount_by_group[1]"
                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}" />
                                </td>
                            </t>
                            <t t-else="">
                                <td style="border: 1px solid;"></td>
                                <td name="td_subtotal" style="border: 1px solid;">
                                    <strong class="mr16">
                                        <span t-esc="amount_by_group[0]"></span>
                                    </strong>
                                </td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;"></td>
                                <td style="border: 1px solid;" class="text-right">
                                    <span t-esc="amount_by_group[1]"
                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}" />
                                </td>
                            </t>
                        </tr>
                    </t>
                    <tr class="text-right" style="border: 1px solid; background-color: #ACE1AF">
                        <td style="border: 1px solid;"></td>
                        <td name="td_total" style="border: 1px solid;">
                            <strong class="mr16">Total Amount</strong>
                        </td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;"></td>
                        <td style="border: 1px solid;" class="text-right">
                            <span t-field="doc.amount_total" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//p[@t-field='doc.note']" position="replace">
            <t t-if="doc.note">
                <strong>Notes:</strong>
                <strong t-field="doc.note" />
            </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <br></br>
        </xpath>
    </template>
</odoo>